{
  "name": "smart-tasks",
  "description": "A playful, synced to-do list Chrome extension backed by Cloudflare Workers.",
  "private": true,
  "version": "1.8.0",
  "type": "module",
  "scripts": {
    "dev": "wxt dev",
    "build": "wxt build",
    "zip": "STORE_BUILD=1 wxt zip",
    "compile": "tsc --noEmit",
    "smoke": "node scripts/smoke.cjs",
    "worker:dev": "npm --prefix worker run dev",
    "worker:deploy": "npm --prefix worker run deploy",
    "postinstall": "wxt prepare",
    "site": "wxt build && node scripts/build-site.mjs",
    "site:deploy": "npm run site && worker/node_modules/.bin/wrangler deploy -c site/wrangler.jsonc",
    "desktop:dev": "node desktop/scripts/tauri.mjs dev",
    "desktop:build": "node desktop/scripts/tauri.mjs build",
    "desktop:mac:fetch": "node desktop/scripts/fetch-mac.mjs",
    "desktop:win:fetch": "node desktop/scripts/fetch-win.mjs",
    "desktop:compile": "tsc --noEmit -p desktop/tsconfig.json"
  },
  "dependencies": {
    "lucide-react": "^1.42.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/cli": "^2.12.6",
    "@types/chrome": "^0.2.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@wxt-dev/module-react": "^1.2.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wxt": "^0.20.27"
  }
}
