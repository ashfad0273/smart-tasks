{
  "name": "smart-tasks",
  "description": "A playful, synced to-do list Chrome extension backed by Cloudflare Workers.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt dev",
    "build": "wxt build",
    "zip": "STORE_BUILD=1 wxt zip",
    "compile": "tsc --noEmit",
    "smoke": "node scripts/smoke.cjs",
    "worker:dev": "npm --prefix worker run dev",
    "worker:deploy": "npm --prefix worker run deploy",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "lucide-react": "^1.42.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@wxt-dev/module-react": "^1.2.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wxt": "^0.20.27"
  }
}
